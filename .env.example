AGENT_ID=server1
AGENT_NAME=server1
# Use host.docker.internal for a broker published on the Docker host, or set
# the hostname/IP of a broker reachable from the container network.
MQTT_HOST=host.docker.internal
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_BASE_TOPIC=nodesense
TZ=America/Sao_Paulo
# Linux: stat -c '%g' /var/run/docker.sock
DOCKER_GID=999
